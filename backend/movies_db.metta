; movies_db.metta
; Auto-generated MeTTa facts for movies, intended to be loaded after &movies is bound.
; Each entry uses add-atom into &movies. Safe to re-run; duplicate atoms may accumulate.
;
; Schema per movie id M (symbol, e.g., tt0399295):
;   (movie M)
;   (imdb-id M "tt0399295")
;   (title M "Lord of War")
;   (year M 2005)
;   (has-genre M "Crime")         ; multi
;   (has-genre M "Drama")
;   (has-director M "Andrew Niccol")
;   (writer M "Andrew Niccol")    ; multi
;   (has-actor M "Nicolas Cage")  ; multi
;   (language M "English")        ; multi
;   (country M "Germany")         ; multi
;   (awards M "2 wins & 3 nominations total")
;   (poster M "https://...")
;   (imdb-rating M 7.6)
;   (imdb-votes M 350984)
;   (besttime-to-watch M "evening")   ; derived by LLM
;   (watch-type M "friends")          ; derived by LLM
;
; This file is intentionally empty initially. Run build_movies_db.py to regenerate.


;!(bind! &movies (new_sp))
!(bind! &movies (new-space))


